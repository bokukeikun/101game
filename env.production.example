# ===========================================
# 本番ビルド・デプロイ用（yarn build:prod / yarn deploy）
# このファイルを .env.production.local にコピーして値を設定
# ===========================================

VITE_FIREBASE_API_KEY=your_prod_api_key
VITE_FIREBASE_AUTH_DOMAIN=vue-101-game.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vue-101-game
VITE_FIREBASE_STORAGE_BUCKET=vue-101-game.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_prod_sender_id
VITE_FIREBASE_APP_ID=your_prod_app_id

VITE_USE_FIREBASE_EMULATOR=false
