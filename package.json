{
  "name": "vue-101-deploy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@3.6.4",
  "volta": {
    "node": "20.11.0",
    "npm": "10.2.4",
    "yarn": "3.6.4"
  },
  "scripts": {
    "dev": "vite",
    "setup:dev-firebase": "bash scripts/setup-dev-firebase.sh",
    "dev:emulator": "concurrently -k -n emulator,vite -c yellow,cyan \"yarn emulators\" \"wait-on tcp:127.0.0.1:8080 && vite --mode emulator\"",
    "emulators": "JAVA_HOME=\"$(brew --prefix openjdk@21)/libexec/openjdk.jdk/Contents/Home\" firebase emulators:start --only firestore --config firebase.emulator.json",
    "deploy:firestore:dev": "firebase deploy --only firestore:rules --config firebase.dev.json --project dev",
    "build": "vite build",
    "preview": "vite preview",
    "build:prod": "vite build --mode production",
    "deploy": "yarn build:prod && firebase deploy",
    "deploy:hosting": "yarn build:prod && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase": "^10.7.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "9",
    "vue-router": "^4.2.5",
    "vuedraggable": "next"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "prettier": "^3.2.0",
    "sass": "^1.69.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.27",
    "wait-on": "^8.0.1"
  }
}
