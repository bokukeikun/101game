rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 101ゲームが実際に使うコレクション（Firebase Auth なし・ルームコード単位）
    // 部屋コードは5文字の英数字（randomCodeGenerator と同じ）
    function isValidRoomCode(roomCode) {
      return roomCode.matches('^[A-Za-z0-9]{5}$');
    }

    // 参加者リスト（users / restartUsers）
    match /users/{roomCode} {
      allow read, write: if isValidRoomCode(roomCode);
    }

    // ゲーム状態（手番・山札・合計など）
    match /initGameState/{roomCode} {
      allow read, write: if isValidRoomCode(roomCode);
    }

    // オンライン状態（ハートビート）
    match /presence/{roomCode} {
      allow read, write: if isValidRoomCode(roomCode);
    }
  }
}
