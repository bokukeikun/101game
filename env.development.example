# ===========================================
# ローカル開発用（yarn dev）
# このファイルを .env.development.local にコピーして値を設定
# ===========================================
#
# 【推奨】開発用 Firebase プロジェクト（vue-101-game-dev）を作成し、
# その Web アプリ設定を以下に貼り付けてください。
# 本番（vue-101-game）のデータとは完全に分離されます。
#
# 開発用プロジェクトの作り方: AGENTS.md の「開発用 Firebase プロジェクト」を参照

VITE_FIREBASE_API_KEY=your_dev_api_key
VITE_FIREBASE_AUTH_DOMAIN=vue-101-game-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vue-101-game-dev
VITE_FIREBASE_STORAGE_BUCKET=vue-101-game-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_dev_sender_id
VITE_FIREBASE_APP_ID=your_dev_app_id

# 開発用クラウド Firebase を使う場合は false（推奨）
VITE_USE_FIREBASE_EMULATOR=false

# ===========================================
# Emulator を使う場合（yarn dev:emulator）のみ true にする
# Java 21 以上 + firebase-tools が必要
# ===========================================
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8080
